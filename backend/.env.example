# Copy this to .env for local development only.
# For the actual deployment, set these same keys as Environment Variables
# in the Vercel project dashboard (Settings -> Environment Variables) instead
# of committing a .env file. See SECRETS_reference.txt (delivered separately,
# do not commit it) for your actual current values pulled from the old server.

# Postgres connection string from your Supabase project
# (Project Settings -> Database -> Connection string -> URI)
DATABASE_URL=postgresql://postgres:your_supabase_password@db.your_project_ref.supabase.co:5432/postgres

# Used to sign login tokens. Keep the same value you were using before if you
# want existing logged-in users to stay logged in, otherwise everyone just
# has to log in again once, which is harmless.
SECRET_KEY=

# Only used if you decide to wire up the Anthropic-based features later,
# not currently called anywhere in the code as of this backup.
ANTHROPIC_API_KEY=

# Not currently used (Reddit mentions are fetched via public RSS, no auth
# needed), safe to leave blank.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=SentiApp/1.0

# Not currently used (the code sends email via Resend, not SendGrid), safe
# to leave blank unless you want to switch providers later.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Used by google_reviews.py
GOOGLE_PLACES_API_KEY=

# Used for sentiment analysis (listener.py) and the AI analyst chat endpoint
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Used to send negative-review alert emails
RESEND_API_KEY=

# Used by google_reviews.py to pull Google reviews via SerpApi
SERPAPI_KEY=

# Optional: set this and Vercel Cron will send it as a Bearer token so the
# /api/cron/listener endpoint can't be triggered by outsiders. Generate any
# random string.
CRON_SECRET=
